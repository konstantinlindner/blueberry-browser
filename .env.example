# Set one of these. The companion agent uses Anthropic if its key is present.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional overrides
# ANTHROPIC_BASE_URL=https://your-gateway   (Claude Code style; /v1 is added)
# ANTHROPIC_AUTH_TOKEN=...                  (used if ANTHROPIC_API_KEY is unset)
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5-5
